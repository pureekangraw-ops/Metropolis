{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metropolis",
  "main": "src/mcp-worker.mjs",
  "compatibility_date": "2026-10-06",
  "build": { "command": "node scripts/write-mcp-source-identity.mjs" },
  "durable_objects": { "bindings": [{ "name": "METROPOLIS_ENTRY", "class_name": "MetropolisEntry" }] },
  "services": [{"binding":"GREENHOUSE_TRANSPORT","service":"greenhouse-transport"},{"binding":"FACTORY_SERVICE","service":"factory-district"}],
  "r2_buckets": [{ "binding": "TABLET_STORAGE", "bucket_name": "factory" }],
  "migrations": [{ "tag": "metropolis-entry-v1", "new_sqlite_classes": ["MetropolisEntry"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "previews": {},
  "vars": {
    "MCP_PUBLIC_ORIGIN": "https://metropolis.pureekangraw.workers.dev",
    "FACTORY_RUNTIME_URL": "https://factory-district.pureekangraw.workers.dev",
    "MCP_WORK_GRANTS": "[{\"actor\":\"LIGHT\",\"action\":\"read\",\"workId\":\"WORK-e459319b-9077-46ca-8191-9e45c30f618d\"},{\"actor\":\"LIGHT\",\"action\":\"handoff\",\"workId\":\"WORK-e459319b-9077-46ca-8191-9e45c30f618d\",\"stationId\":\"*\",\"operation\":\"*\"},{\"actor\":\"LIGHT\",\"action\":\"return\",\"workId\":\"WORK-e459319b-9077-46ca-8191-9e45c30f618d\"},{\"actor\":\"LIGHT\",\"action\":\"cancel\",\"workId\":\"WORK-e459319b-9077-46ca-8191-9e45c30f618d\"},{\"actor\":\"LIGHT\",\"action\":\"complete\",\"workId\":\"WORK-e459319b-9077-46ca-8191-9e45c30f618d\"}]",
    "MCP_ALLOWED_ORIGINS": "[]"
  }
}
