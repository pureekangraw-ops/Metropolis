{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metropolis",
  "main": "src/mcp-worker.mjs",
  "compatibility_date": "2026-10-06",
  "build": { "command": "node scripts/write-mcp-source-identity.mjs" },
  "durable_objects": { "bindings": [{ "name": "METROPOLIS_ENTRY", "class_name": "MetropolisEntry" }] },
  "migrations": [{ "tag": "metropolis-entry-v1", "new_sqlite_classes": ["MetropolisEntry"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "previews": {},
  "vars": { "MCP_WORK_GRANTS": "[]", "MCP_ALLOWED_ORIGINS": "[]" }
}
