{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metropolis",
  "main": "src/mcp-worker.mjs",
  "compatibility_date": "2026-10-06",
  "build": { "command": "node scripts/write-mcp-source-identity.mjs" },
  "durable_objects": { "bindings": [{ "name": "METROPOLIS_ENTRY", "class_name": "MetropolisEntry" }] },
  "r2_buckets": [{ "binding": "TABLET_STORAGE", "bucket_name": "factory" }],
  "migrations": [{ "tag": "metropolis-entry-v1", "new_sqlite_classes": ["MetropolisEntry"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "previews": {},
  "vars": {
    "MCP_PUBLIC_ORIGIN": "https://metropolis.pureekangraw.workers.dev",
    "FACTORY_RUNTIME_URL": "https://factory-district.pureekangraw.workers.dev",
    "MCP_WORK_GRANTS": "[]",
    "MCP_ALLOWED_ORIGINS": "[]"
  }
}
